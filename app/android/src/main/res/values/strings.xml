    <!-- Bluetooth permission -->
    <string name="permission_title">Bluetooth permission needed</string>
    <string name="permission_explanation">KnightLink needs to find and connect to your OBD adapter over Bluetooth. Android calls this the Nearby devices permission (on Android 11 and older it is called Location, because Android requires it for Bluetooth scanning). KnightLink never reads your location.</string>
