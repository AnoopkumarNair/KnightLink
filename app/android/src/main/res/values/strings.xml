    <!-- Drive data -->
    <string name="drive_data_title">Drive data</string>
    <string name="drive_data_motion">KnightLink records the motion sensors of the phone with each drive, so the data of the car can be read next to how the car moved.</string>
    <string name="drive_data_location_on">The location of the phone is recorded too. It stays on this phone; a shared copy has it rounded to about a kilometre.</string>
    <string name="drive_data_location_off">Location is not recorded. Allow it to record where the drive was, for speed and bearing checks. It stays on this phone; a shared copy has it rounded to about a kilometre.</string>
