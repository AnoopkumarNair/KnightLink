<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Foreground service permissions. They are declared for the real adapter link, which runs as a connectedDevice
      foreground service; the demo does not use them (see SessionService.needsForegroundService). The Bluetooth permissions
      that Android 14 requires at run time for that type (and that the scan and the link need anyway) are declared by the
      platform:ble-android module and merged into this manifest.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Android 13 and later: asked for at runtime; the app works without it, only the notification is missing. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Optional: the phone's position is recorded next to the drive's data when the user allows it (and only then). The Bluetooth module
      declares this permission for Android 11 and older only, so the limit is removed here. The position stays in the app's private
      recordings; a shared copy has it rounded to about a kilometre.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:remove="android:maxSdkVersion" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Push to talk: the microphone, asked for the first time the talk button is pressed (after an explanation). Nothing is recorded
      or kept by the app; the phone's speech recogniser hears the audio only between the press and the end of the question.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11 and later: without these the app cannot see the phone's speech recogniser and text-to-speech engine. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.KnightLink">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- stopWithTask false: swiping the app away from the recents list must not end a session. -->
        <service
            android:name=".session.SessionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location"
            android:stopWithTask="false" />

        <!-- Hands out the scrubbed copy of a recording to the share sheet; see res/xml/file_provider_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>

</manifest>
